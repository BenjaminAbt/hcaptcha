@model BenjaminAbt.HCaptcha.Samples.AspNetCore.Controllers.IndexViewModel
@using BenjaminAbt.HCaptcha
@using Microsoft.Extensions.Options
@inject IOptions<HCaptchaOptions> CaptchaOptions

@{
    HCaptchaOptions captchaOptions = CaptchaOptions.Value;
}


<div class="container">
    <h1 class="mt-5">hCaptcha Demo</h1>
    <form class="card p-2" action="" method="POST">
        @Html.AntiForgeryToken()
        <script src="@(captchaOptions.JavaScriptUrl)" async defer></script>
        <div class="form-group">
            <div class="h-captcha" data-sitekey="@(captchaOptions.SiteKey)"></div>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

@if (Model?.Response is HCaptchaVerifyResponse response)
{
    <section class="container" role="status">
        <h2>Challenge verified</h2>
        <dl>
            <dt>Hostname</dt>
            <dd>@response.Hostname</dd>
            <dt>Challenge time</dt>
            <dd>@response.Timestamp</dd>
        </dl>
    </section>
}
